# ===== Servidor =====
PORT=3000

# ===== WhatsApp Cloud API (Meta) =====
# developers.facebook.com > Tu app > WhatsApp > Configuración de la API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Una palabra secreta que inventas tú; la misma se pone en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=mi_token_secreto_123
# (Opcional pero recomendado) App Secret: Configuración de la app > Básica
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Plantillas aprobadas en Meta (déjalas vacías mientras pruebas: se enviará texto normal)
TEMPLATE_RECORDATORIO=
TEMPLATE_AVISO_ENCARGADO=
TEMPLATE_IDIOMA=es

# ===== Google Calendar =====
# Ruta al archivo JSON de la cuenta de servicio (déjalo vacío para usar un calendario simulado)
GOOGLE_CREDENTIALS_FILE=./credenciales-google.json
# ID del calendario (correo de la cuenta de Google o el ID del calendario compartido)
GOOGLE_CALENDAR_ID=

# ===== Negocio =====
ZONA_HORARIA=America/Guatemala
# Número del encargado con código de país, sin + ni espacios (ej: 50234405335)
TELEFONO_ENCARGADO=
# Cuántas horas antes de la cita se manda el recordatorio
HORAS_RECORDATORIO=24
